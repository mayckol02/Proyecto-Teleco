## Auto detect text/binary and normalize line endings
* text=auto

# Force LF for source files (posix-friendly builds)
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf

# Use CRLF for Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.war binary
*.ear binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
